# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
# Agent harness tool-approval state: machine-local, and until now kept out of
# git only by the developer's own global ignore — not by anything in the clone.
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked)
# `.env` plus `.env*.local` left .env.production / .env.development / .env.test
# committable, and Next loads all three — one `cp .env.local .env.production` to
# test a prod build would have put SUPABASE_SERVICE_ROLE_KEY in history.
.env*
!.env.example

# typescript
*.tsbuildinfo

# vercel
.vercel

# supabase CLI scratch state (linked project ref, pooler URL, tool versions).
# Machine-local — should never have been committed.
supabase/.temp/
supabase/.branches/

# Sample documents written by scripts/gen-samples.mjs and scripts/shot-doc.mjs.
# Was tracked, so every run left modified binaries in `git status` — jszip
# re-stamps the docx/pptx entry dates on each generate.
/tmp-samples/

.vercel
