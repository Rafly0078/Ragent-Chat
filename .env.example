# ============================================================================
# Local AI Bridge — Ollama upstream (SERVER-ONLY, hidden from the browser)
# The frontend calls /api/bridge/*; only the server reads this. Prefer this
# over NEXT_PUBLIC_API_URL so the upstream URL never ships in the client bundle.
# ============================================================================
OLLAMA_API_URL=https://my-ollama-api.example.com

# Bearer token, if the tunnel in front of Ollama requires one (SERVER-ONLY).
# Sent as `Authorization: Bearer <token>` on every bridge request. A proxy that
# answers 401 to unauthenticated calls — including /api/tags — needs this or the
# model list comes back empty and chat fails. Leave unset for a bare Ollama.
# In "Direct" connection mode the token is entered in Settings instead, since the
# browser is the one making the call.
# OLLAMA_API_TOKEN=

# Legacy/public fallback. Still honored by the bridge if OLLAMA_API_URL is unset.
# Setting it also marks the app "configured" for the client. Optional now.
NEXT_PUBLIC_API_URL=https://my-ollama-api.example.com

# Set to "true" to hide chat (guest/static-only deploy with no model backend).
# NEXT_PUBLIC_DISABLE_BRIDGE=false

# ============================================================================
# Supabase — auth, database, storage. Leave blank to run in guest-only mode
# (localStorage persistence, no sign-in). URL + anon key are PUBLIC (safe in the
# browser under RLS). The service-role key is SECRET and server-only.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Owner gating — email(s) allowed to curate model display names (SERVER-ONLY).
# Comma-separated for multiple. The signed-in user with this verified email
# sees the rename UI in the model picker; everyone else only reads the names.
# Requires SUPABASE_SERVICE_ROLE_KEY (writes bypass RLS behind the owner check).
# ============================================================================
OWNER_EMAIL=you@example.com

# ============================================================================
# Tavily — web search (SERVER-ONLY, never shipped to the browser).
# Powers the Globe toggle in chat via /api/search. Get a key at tavily.com
# (free tier available). Leave unset to disable web search (route returns 501).
# ============================================================================
TAVILY_API_KEY=tvly-your-tavily-api-key

# ============================================================================
# Default cloud AI provider. Makes a custom endpoint the built-in chat default.
# URL/model/protocol configure the browser; API key stays SERVER-ONLY and is
# injected only when requests target the matching default endpoint.
# ============================================================================
# NEXT_PUBLIC_DEFAULT_AI_PROVIDER=custom
# NEXT_PUBLIC_DEFAULT_AI_API_URL=https://api.example.com/v1
# NEXT_PUBLIC_DEFAULT_AI_MODEL=your-model-id
# NEXT_PUBLIC_DEFAULT_AI_PROTOCOL=openai
# DEFAULT_AI_API_KEY=your-secret-api-key

# Canonical site origin for metadata, Open Graph, robots and the sitemap.
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL, which follows
# an alias rename automatically. Set this once you attach a real custom domain.
# NEXT_PUBLIC_SITE_URL=https://ragent-chat.vercel.app
